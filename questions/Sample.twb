            <column-instance column='[Order Date]' derivation='MDY' name='[md:Order Date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation1 (copy)_0685565775962116]' derivation='None' name='[none:Calculation1 (copy)_0685565775962116:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
