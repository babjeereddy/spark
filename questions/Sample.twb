      <aliases enabled='yes' />
      <column caption='Calculation1 (copy)' datatype='boolean' name='[Calculation1 (copy)_0685565775962116]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 0685565769170946] = &quot;YTD&quot; THEN&#13;&#10;&#13;&#10;    [Order Date] &gt;= DATETRUNC(&apos;year&apos;, [Calculation_0685565766205440])&#13;&#10;    AND [Order Date] &lt;= [Calculation_0685565766205440]&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 0685565769170946] = &quot;QTD&quot; THEN&#13;&#10;&#13;&#10;    [Order Date] &gt;= DATETRUNC(&apos;quarter&apos;, [Calculation_0685565766205440])&#13;&#10;    AND [Order Date] &lt;= [Calculation_0685565766205440]&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 0685565769170946] = &quot;MTD&quot; THEN&#13;&#10;&#13;&#10;    [Order Date] &gt;= DATETRUNC(&apos;month&apos;, [Calculation_0685565766205440])&#13;&#10;    AND [Order Date] &lt;= [Calculation_0685565766205440]&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;    [Order Date] &gt;= DATETRUNC(&apos;week&apos;, [Calculation_0685565766205440])&#13;&#10;    AND [Order Date] &lt;= [Calculation_0685565766205440]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Max_Order_Date' datatype='date' name='[Calculation_0685565766205440]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{max([Order Date])}' />
      </column>
      <column caption='Calculation1' datatype='boolean' name='[Calculation_0685565766868993]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 0685565769170946] = &quot;YTD&quot; THEN&#13;&#10;&#13;&#10;    [Order Date] &gt;= DATETRUNC(&apos;year&apos;, [Calculation_0685565766205440])&#13;&#10;    AND [Order Date] &lt;= [Calculation_0685565766205440]&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 0685565769170946] = &quot;QTD&quot; THEN&#13;&#10;&#13;&#10;    [Order Date] &gt;= DATETRUNC(&apos;quarter&apos;, [Calculation_0685565766205440])&#13;&#10;    AND [Order Date] &lt;= [Calculation_0685565766205440]&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 0685565769170946] = &quot;MTD&quot; THEN&#13;&#10;&#13;&#10;    [Order Date] &gt;= DATETRUNC(&apos;month&apos;, [Calculation_0685565766205440])&#13;&#10;    AND [Order Date] &lt;= [Calculation_0685565766205440]&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;    [Order Date] &gt;= DATETRUNC(&apos;week&apos;, [Calculation_0685565766205440])&#13;&#10;    AND [Order Date] &lt;= [Calculation_0685565766205440]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Fixed_Sales' datatype='real' name='[Calculation_0685565776605189]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : sum([Sales]) }' />
      </column>
      <column aggregation='Attribute' caption='Exclude' datatype='real' name='[Calculation_0685565777309702]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [Category]:sum([Sales]) }' />
      </column>
      <column caption='Fixed Category' datatype='real' name='[Calculation_0685565779054599]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Category]:Sum([Sales]) }' />
      </column>
      <column aggregation='Attribute' caption='Exclude_Subcategory' datatype='real' name='[Calculation_0685565781250060]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [Sub-Category]:sum([Sales])&#13;&#10; }' />
      </column>
      <column caption='Include Lod' datatype='real' name='[Calculation_0685565783134221]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [Region]:sum([Profit]) }' />
      </column>
      <column caption='Country_Sales' datatype='real' name='[Calculation_0685565784608782]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Country/Region]:sum([Sales]) }' />
      </column>
      <column aggregation='Attribute' caption='Region Sales' datatype='real' name='[Calculation_0685565785575439]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [State/Province] :sum([Sales]) }' />
      </column>
      <column caption='Customer Average Sales' datatype='real' name='[Calculation_0685565786578960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg({INCLUDE [Customer ID]: sum([Sales])})' />
      </column>
